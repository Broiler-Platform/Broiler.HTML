<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Every pin must exist on nuget.org, the only restore source. -->
  <ItemGroup>
    <PackageVersion Include="Broiler.CSS" Version="0.1.0-preview.16" />
    <PackageVersion Include="Broiler.CSS.Dom" Version="0.1.0-preview.16" />
    <PackageVersion Include="Broiler.Dom.Html" Version="0.1.0-preview.14" />
    <!-- BFontStyle.Face, the web-font program a render list carries to the backend; it must reach nuget.org before this pin ships. -->
    <PackageVersion Include="Broiler.Graphics" Version="0.1.0-preview.11" />
    <PackageVersion Include="Broiler.Graphics.Windows" Version="0.1.0-preview.11" />
    <PackageVersion Include="Broiler.Layout" Version="0.1.0-preview.22" />
    <PackageVersion Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.14" />
    <!-- The profile network session the renderer's loaders send through; it must reach nuget.org before this pin ships. -->
    <PackageVersion Include="Broiler.Net" Version="0.1.0-preview.2" />
  </ItemGroup>
  <!-- Test-only packages, the same versions as the sibling Broiler repositories. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>