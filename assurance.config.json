    "Source/Broiler.HTML.Core/Broiler.HTML.Core.csproj",
    "Source/Broiler.HTML.Dom/Broiler.HTML.Dom.csproj",
    "Source/Broiler.HTML.Graphics/Broiler.HTML.Graphics.csproj",
