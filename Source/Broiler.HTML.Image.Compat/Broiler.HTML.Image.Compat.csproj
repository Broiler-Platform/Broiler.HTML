<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <Description>Backend-neutral image adapter for Broiler.HTML, with the bundled Vazirmatn fallback font for unregistered and default CSS font families.</Description>
    <PackageLicenseExpression>Apache-2.0 AND BSD-3-Clause AND OFL-1.1</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.HTML.Image\Broiler.HTML.Image.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled OFL fallback font (Vazirmatn): provides glyphs for
         unregistered/default CSS families, including Latin and the
         Arabic/Persian script with GSUB shaping data.  See Fonts/Vazirmatn-OFL.txt. -->
    <EmbeddedResource Include="Fonts\Vazirmatn-Regular.ttf">
      <LogicalName>Broiler.HTML.Image.Compat.Fonts.Vazirmatn-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <!-- The OFL requires its copyright notice and license to travel with the font. -->
    <None Include="Fonts\Vazirmatn-OFL.txt" Pack="true" PackagePath="LICENSES\" />
  </ItemGroup>
</Project>
