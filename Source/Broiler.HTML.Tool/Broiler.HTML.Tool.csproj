<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Single target: the conformance harness runs this through `dotnet run` without choosing a
         target framework, which fails for a multi-targeted project. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Built with the solution so CI catches breakage, but never shipped: eng/pack.ps1 packs
         every packable project in the solution. -->
    <IsPackable>false</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>broiler-html-render</ToolCommandName>
    <PackageId>Broiler.HTML.Tool</PackageId>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.HTML.Dom\Broiler.HTML.Dom.csproj" />
    <ProjectReference Include="..\Broiler.HTML.Graphics\Broiler.HTML.Graphics.csproj" />
    <ProjectReference Include="..\Broiler.HTML.Image.Compat\Broiler.HTML.Image.Compat.csproj" />
    <ProjectReference Include="..\Broiler.HTML.Image\Broiler.HTML.Image.csproj" />
  </ItemGroup>

</Project>
